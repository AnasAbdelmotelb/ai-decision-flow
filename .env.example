# Copy to .env.local (gitignored). These defaults use a local Ollama server, so no paid key is needed.
OPENAI_BASE_URL=http://localhost:11434/v1/
OPENAI_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_MS=20000
# 1 = canned answers, no model call
LLM_STUB=0

# Use the local Inngest dev server (no Inngest Cloud keys needed)
INNGEST_DEV=1
